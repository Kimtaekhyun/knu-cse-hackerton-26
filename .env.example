# 값은 비워 두고 이름만 적는다. 실제 값은 .env에 넣는다
# 이미지 인식에 쓸 AI: gemini(기본) 또는 claude
# LLM_PROVIDER=
GEMINI_API_KEY=
# LLM_PROVIDER=claude일 때 필요 (platform.claude.com > API Keys)
ANTHROPIC_API_KEY=
# Claude 시간표 추출 모델 (기본 claude-opus-5-5)
# CLAUDE_TIMETABLE_MODEL=
# 판서 추출 모델 (기본 gemini-3.5-flash-lite)
# GEMINI_MODEL=
# 시간표 추출 모델 (기본 gemini-3.5-flash-lite)
# TIMETABLE_MODEL=
# 로그인 토큰(JWT) 서명 키. 32자 이상 무작위 값 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
# 로그인 토큰 유효 기간(일, 기본 30)
# JWT_EXPIRE_DAYS=
# 카카오 앱 ID (카카오 개발자 콘솔 > 앱 관리 페이지 상단의 앱 ID)
KAKAO_APP_ID=
# DB 주소. docker compose로 실행하면 자동으로 설정되므로 주석으로 둔다 (빈 값으로 두면 기본값을 덮어씀)
# (로컬에서 uv로 실행할 때 기본값: postgresql+psycopg://pansoham:pansoham@localhost:5432/pansoham)
# DATABASE_URL=
