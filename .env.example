# 값은 비워 두고 이름만 적는다. 실제 값은 .env에 넣는다
# 이미지 인식(시간표 · 판서)에 쓸 AI: claude(기본) 또는 gemini
# LLM_PROVIDER=
# 시간표 · 판서 인식(기본 AI)과 학사일정 웹 검색(#173)에 필요 (platform.claude.com > API Keys)
# 없으면 시간표 · 판서 인식이 안 되고, 학사일정이 없는 학교는 추정 개강일(1학기 3/2 · 2학기 9/1)로 시험 기간을 계산한다
ANTHROPIC_API_KEY=
# Claude 시간표 추출 모델 (기본 claude-haiku-5-5)
# CLAUDE_TIMETABLE_MODEL=
# Claude 판서 추출 모델 (기본 claude-haiku-5-5)
# CLAUDE_NOTE_MODEL=
# 학사일정 웹 검색 모델 (기본 claude-opus-5-5)
# CALENDAR_MODEL=
# LLM_PROVIDER=gemini일 때만 필요
# GEMINI_API_KEY=
# Gemini 판서 추출 모델 (기본 gemini-3.5-flash-lite)
# GEMINI_MODEL=
# Gemini 시간표 추출 모델 (기본 gemini-3.5-flash-lite)
# TIMETABLE_MODEL=
# 로그인 토큰(JWT) 서명 키. 32자 이상 무작위 값 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
# 로그인 토큰 유효 기간(일, 기본 30)
# JWT_EXPIRE_DAYS=
# 카카오 앱 ID (카카오 개발자 콘솔 > 앱 관리 페이지 상단의 앱 ID)
KAKAO_APP_ID=
# DB 주소. docker compose로 실행하면 자동으로 설정되므로 주석으로 둔다 (빈 값으로 두면 기본값을 덮어씀)
# (로컬에서 uv로 실행할 때 기본값: postgresql+psycopg://pansoham:pansoham@localhost:5432/pansoham)
# DATABASE_URL=
# 판서 사진 저장 폴더. docker compose는 자동으로 /media(볼륨)를 쓰므로 주석으로 둔다
# (로컬에서 uv로 실행할 때 기본값: server/media)
# MEDIA_DIR=
# 판서를 동시에 몇 장 처리할지 (기본 1 = 올린 순서대로 한 장씩)
# PIPELINE_WORKERS=
