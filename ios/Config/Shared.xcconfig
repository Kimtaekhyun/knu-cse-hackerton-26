// 공통 기본값. 개인 값은 맨 아래 Local.xcconfig가 덮어쓴다 (#22).
// 개인 값(Team ID · Bundle ID · 서버 주소)은 이 파일이 아니라 Local.xcconfig에만 적는다.

DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.knu.pansoham

// 앱이 요청을 보낼 서버. 시뮬레이터는 같은 Mac의 docker compose(localhost)로 간다.
// xcconfig에서 //는 주석이라 URL이 잘리므로 빈 변수 $()를 끼워 넣는다.
API_BASE_URL = http:/$()/localhost:8000

#include? "Local.xcconfig"
