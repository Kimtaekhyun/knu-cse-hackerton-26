<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱이 요청을 보낼 서버 주소. xcconfig의 API_BASE_URL 값이 들어간다 (APIConfig.baseURL이 읽음) -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<!-- 같은 Wi-Fi의 개발 서버(http)에 붙을 수 있게 로컬 네트워크만 예외로 둔다 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 판서 촬영(09). 없으면 카메라를 켜는 순간 앱이 종료된다 -->
	<key>NSCameraUsageDescription</key>
	<string>수업 판서를 찍어 정리하기 위해 카메라를 사용해요. 칠판과 화면만 찍어 주세요.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 Wi-Fi의 개발 서버에 연결하기 위해 사용해요.</string>
	<!-- 카카오 네이티브 앱 키. xcconfig의 KAKAO_NATIVE_APP_KEY 값이 들어간다 (KakaoLogin.configure()가 읽음) -->
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>$(KAKAO_NATIVE_APP_KEY)</string>
	<!-- 카카오톡 앱으로 로그인하고 돌아올 때 쓰는 주소 (kakao + 네이티브 앱 키) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>kakao</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
	</array>
	<!-- 카카오톡 앱이 설치돼 있는지 확인할 때 쓰는 주소 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
	</array>
</dict>
</plist>
